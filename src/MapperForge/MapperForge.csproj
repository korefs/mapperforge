<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>MapperForge</PackageId>
    <Title>MapperForge</Title>
    <Description>Compile-time object mapping for .NET with zero runtime reflection.</Description>
    <PackageTags>mapper;mapping;source-generator;roslyn;performance;ddd;clean-architecture</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/your-org/mapperforge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/your-org/mapperforge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>MapperForge Contributors</Authors>
    <Company>MapperForge</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeMapperForgeGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MapperForge.Generator\MapperForge.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="IncludeMapperForgeGenerator">
    <MSBuild Projects="..\MapperForge.Generator\MapperForge.Generator.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="MapperForgeGeneratorAssembly" />
    </MSBuild>
    <Error Condition="!Exists('%(MapperForgeGeneratorAssembly.Identity)')"
           Text="MapperForge generator assembly is missing: %(MapperForgeGeneratorAssembly.Identity). Build the generator before packing with --no-build." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(MapperForgeGeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
